# Server Configuration
PORT=3001
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:5173

# Redis Configuration (for BullMQ job queue)
# 
# IMPORTANT: Priority order: REDIS_URL > REDIS_HOST + REDIS_PORT
# 
# ========================================
# LOCAL DEVELOPMENT
# ========================================
# Option 1: Use individual variables (recommended for local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Option 2: Use REDIS_URL (alternative for local)
# REDIS_URL=redis://localhost:6379
#
# Note: In development, if no Redis config is provided,
# the app will auto-fallback to localhost:6379
#
# ========================================
# PRODUCTION (Render/Cloud)
# ========================================
# IMPORTANT: In production, you MUST provide Redis config!
# The app will NOT auto-fallback to localhost in production.
#
# Option 1: Use REDIS_URL (recommended for cloud)
# Format: redis://:password@host:port
# Example: REDIS_URL=redis://:mypassword@d-redis-xxx.render.com:6379
# 
# Option 2: Use individual variables (if REDIS_URL not available)
# REDIS_HOST=d-redis-xxx.render.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your-password-here
#
# On Render: Link Redis service in Web Service settings
# Render will automatically inject: REDIS_HOST, REDIS_PORT, REDIS_PASSWORD
#
# ========================================
# BEHAVIOR
# ========================================
# - If Redis is unavailable: App will start but queue features disabled
# - Check /api/health/redis for Redis connection status
# - Workers will only start if Redis is available

# Download Configuration
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DOWNLOADS=3
# Giới hạn kích thước file: 50000 MB = 50 GB (phù hợp với video 15 giờ chất lượng cao)
MAX_FILE_SIZE_MB=50000
# Giới hạn thời lượng video: 54000 giây = 15 giờ = 900 phút
MAX_DURATION_SECONDS=54000
CHUNK_SIZE_MB=100

# yt-dlp Configuration
# Nếu yt-dlp không có trong PATH, bạn có thể:
# 1. Chỉ định đường dẫn đầy đủ:
#    Windows: YTDLP_PATH=C:\path\to\yt-dlp.exe
#    Linux/Mac: YTDLP_PATH=/usr/local/bin/yt-dlp
# 2. Hoặc dùng Python module (tự động fallback nếu yt-dlp không tìm thấy):
#    YTDLP_PATH=python -m yt_dlp
#    Hoặc: YTDLP_PATH=python3 -m yt_dlp
# 
# Note: Nếu bạn thấy warning "yt-dlp not found in PATH", bạn có thể set trực tiếp:
# YTDLP_PATH=python -m yt_dlp
# để tránh warning và tăng tốc độ khởi động
YTDLP_PATH=yt-dlp

# yt-dlp Advanced Options (for TikTok, SoundCloud, etc.)
# User agent để bypass restrictions
YTDLP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
# Optional: Cookie file path (Netscape format) để bypass rate limits
# YTDLP_COOKIE_FILE=./cookies.txt
# Optional: Referer URL
# YTDLP_REFERER=https://www.tiktok.com/

# FFmpeg Configuration
# Nếu FFmpeg không có trong PATH, chỉ định đường dẫn đầy đủ:
# Windows: FFMPEG_PATH=C:\path\to\ffmpeg.exe
# Linux/Mac: FFMPEG_PATH=/usr/local/bin/ffmpeg
FFMPEG_PATH=ffmpeg

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log


